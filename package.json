{
  "name": "vite-vue3-template",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --mode development",
    "prod": "vite --mode production",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "dayjs": "^1.11.20",
    "pinia": "^3.0.4",
    "vant": "^4.9.24",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/node": "^24.12.2",
    "@unocss/eslint-config": "^66.6.8",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vueuse/core": "^14.2.1",
    "cross-env": "^10.1.0",
    "eruda": "^3.4.3",
    "es-toolkit": "^1.45.1",
    "eslint": "^10.2.1",
    "lint-staged": "^16.4.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^8.0.9",
    "vue-tsc": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  }
}
