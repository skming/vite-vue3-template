{
  "name": "vite-vue3-template",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --mode development",
    "prod": "vite --mode production",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.1.0",
    "vant": "^4.10.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@unocss/eslint-config": "^66.11.0",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.4.0",
    "cross-env": "^10.1.0",
    "eruda": "^3.4.3",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.106.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
